APP_NAME="Project Management API"
APP_LANG=id
APP_DEBUG=false
API_PREFIX=api/v1
APP_KEY=YOUR_APP_KEY_HERE
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

USE_DOMAIN_ON_SWAGGER=false

PORT=8091
NODE_ENV=development
LOG_LEVEL=error
LOG_DIR=logs

# Database Configuration
DB_DRIVER=postgres
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

# Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=DB_USER_HERE
DB_NAME=DB_NAME_HERE
DB_PASS=DB_PASS_HERE

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=REDIS_USER_HERE
REDIS_PASSWORD=REDIS_PASSWORD_HERE

SOCKET_CORS_ORIGINS=http://localhost:8091,http://127.0.0.1:8091

# JWT
JWT_SECRET=JWT_SECRET_HERE
JWT_TTL=60
JWT_REFRESH_TTL=43200

CORS_ALLOWED_ORIGINS="*"
CORS_MAX_AGE=86400

# SWAGGER
SWAGGER_TITLE="Project Management API (PT. PLN Nusa Daya)"
SWAGGER_VERSION="1.0.0"
SWAGGER_DESCRIPTION="Dokumentasi REST API Project Management API (PT. PLN Nusa Daya)"


# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5432
RABBITMQ_USERNAME=RABBITMQ_USERNAME_HERE
RABBITMQ_PASSWORD=RABBITMQ_PASSWORD_HERE
RABBITMQ_VHOST=/

# MinIO Storage
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY="YOUR_MINIO_ACCESS_KEY_HERE"
MINIO_SECRET_KEY="YOUR_MINIO_SECRET_KEY_HERE"
MINIO_REGION=""  # Default MinIO
MINIO_BUCKET="YOUR_MINIO_BUCKET_HERE"
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=root

# Rate Limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# URL Server Grafana Loki (Port default Loki: 3100)
LOKI_PORT=3100
LOKI_USERNAME=YOUR_LOKI_USERNAME_HERE
LOKI_PASSWORD=YOUR_LOKI_PASSWORD_HERE
LOKI_ENABLED=true
LOG_ENVIRONMENT="${NODE_ENV}"
LOG_APP_NAME=warehouse-api
LOKI_TENANT_ID="tenant-1"
LOKI_BATCH_INTERVAL=2
LOKI_MULTITENANCY=false
LOKI_TIMEOUT_MS=10000

# Grafana Configuration
GRAFANA_URL=YOUR_GRAFANA_URL_HERE
GRAFANA_ADMIN_USER=YOUR_GRAFANA_ADMIN_USER_HERE
GRAFANA_ADMIN_PASSWORD=YOUR_GRAFANA_ADMIN_PASSWORD_HERE


# Socket URL Configuration
SOCKET_URL=YOUR_SOCKET_URL_HERE
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here