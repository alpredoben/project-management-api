{
  "name": "warehouse-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev:server": "tsx watch src/server.ts",
    "dev": "concurrently \"npm run dev:server\" \"npm run tailwind:watch\"",
    "build": "tsc",
    "tailwind:build": "tailwindcss -i ./src/styles/input.css -o ./public/css/style.css --minify",
    "tailwind:watch": "tailwindcss -i ./src/styles/input.css -o ./public/css/style.css --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:generate:warehouse": "typeorm-ts-node-commonjs migration:generate -d src/database/cli-warehouse.ts",
    "migration:run:warehouse": "typeorm-ts-node-commonjs migration:run -d src/database/cli-warehouse.ts",
    "migration:revert:warehouse": "typeorm-ts-node-commonjs migration:revert -d src/database/cli-warehouse.ts",
    "migration:generate:teams": "typeorm-ts-node-commonjs migration:generate -d src/database/cli-teams.ts",
    "migration:run:teams": "typeorm-ts-node-commonjs migration:run -d src/database/cli-teams.ts",
    "migration:revert:teams": "typeorm-ts-node-commonjs migration:revert -d src/database/cli-teams.ts",
    "debug:notif": "tsx src/debug/test-notification.ts",
    "debug:loki": "tsx src/debug/test-loki.ts",
    "debug:loki:prod": "node dist/debug/test-loki.js"
  },
  "keywords": [
    "index",
    "warehouse",
    "pln",
    "nusa daya"
  ],
  "author": "PT. PLN Nusa Daya",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "amqplib": "^2.0.1",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dayjs": "^1.11.22",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "i18next": "^26.3.6",
    "i18next-fs-backend": "^2.6.7",
    "i18next-http-middleware": "^3.9.8",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "mysql2": "^3.23.3",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "redis": "^5.12.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.6"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.30",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^10.0.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3"
  }
}
