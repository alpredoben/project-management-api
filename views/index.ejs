<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Warehouse Documentation Service - PT. PLN Nusa Daya</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: 'Inter', sans-serif;
      }

      /* Custom Keyframe Animations */
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes slideBg {
        from {
          background-position: 0 0;
        }
        to {
          background-position: 24px 24px;
        }
      }

      @keyframes float {
        0%,
        100% {
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-8px);
        }
      }

      @keyframes ring {
        0%,
        100% {
          transform: rotate(0deg);
        }
        25% {
          transform: rotate(15deg);
        }
        75% {
          transform: rotate(-15deg);
        }
      }

      /* Animation Utility Classes */
      .animate-fade-in-up {
        opacity: 0;
        animation: fadeInUp 0.6s ease-out forwards;
      }

      .delay-100 {
        animation-delay: 100ms;
      }
      .delay-200 {
        animation-delay: 200ms;
      }
      .delay-300 {
        animation-delay: 300ms;
      }
      .delay-400 {
        animation-delay: 400ms;
      }

      .animate-bg-pattern {
        animation: slideBg 4s linear infinite;
      }

      .animate-float {
        animation: float 5s ease-in-out infinite;
      }

      .group:hover .group-hover\:animate-ring {
        animation: ring 0.5s ease-in-out infinite;
        transform-origin: top center;
      }
    </style>
  </head>
  <body
    class="bg-slate-50 min-h-screen flex items-center justify-center p-4 selection:bg-blue-900 selection:text-white"
  >
    <div class="max-w-3xl w-full animate-fade-in-up">
      <!-- Main Card -->
      <div
        class="bg-white rounded-2xl shadow-xl hover:shadow-2xl transition-shadow duration-500 overflow-hidden border border-gray-100"
      >
        <!-- Header Section -->
        <div
          class="bg-blue-900 px-8 py-16 text-center relative overflow-hidden group"
        >
          <!-- Animated Background Pattern -->
          <div
            class="absolute inset-0 opacity-20 animate-bg-pattern"
            style="
              background-image: radial-gradient(
                circle at 2px 2px,
                white 2px,
                transparent 0
              );
              background-size: 24px 24px;
            "
          ></div>

          <!-- Decorative Ambient Glow (Visible on Hover) -->
          <div
            class="absolute -top-10 -left-10 w-40 h-40 bg-white/5 rounded-full blur-2xl group-hover:scale-150 transition-transform duration-700 ease-out"
          ></div>
          <div
            class="absolute -bottom-10 -right-10 w-40 h-40 bg-white/5 rounded-full blur-2xl group-hover:scale-150 transition-transform duration-700 ease-out"
          ></div>

          <div class="relative z-10 animate-float">
            <h1
              class="text-3xl md:text-4xl font-bold text-white mb-3 tracking-tight drop-shadow-md"
            >
              Warehouse Documentation Service
            </h1>
            <p
              class="text-blue-100 text-lg md:text-xl font-medium tracking-wide"
            >
              PT. PLN Nusa Daya
            </p>
          </div>
        </div>

        <!-- Navigation Section -->
        <div class="p-8 md:p-10">
          <p
            class="text-center text-gray-500 mb-8 text-sm md:text-base animate-fade-in-up delay-100"
          >
            Silakan pilih portal layanan yang ingin Anda tuju:
          </p>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
            <!-- Button: API Health -->
            <a
              href="/api/v1/health"
              class="group flex flex-col items-center justify-center p-6 rounded-xl border-2 border-slate-200 hover:border-blue-900 hover:bg-slate-50 transition-all duration-300 hover:-translate-y-2 hover:shadow-lg animate-fade-in-up delay-200"
            >
              <svg
                class="w-10 h-10 text-blue-900 mb-3 group-hover:scale-125 group-hover:rotate-12 transition-transform duration-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
              <span
                class="font-semibold text-slate-800 group-hover:text-blue-900 transition-colors text-center"
                >API Health</span
              >
              <span class="text-xs text-slate-400 mt-1 font-mono text-center"
                >/api/v1/health</span
              >
            </a>

            <!-- Button: API Docs (Primary) -->
            <a
              href="/docs"
              class="group flex flex-col items-center justify-center p-6 rounded-xl bg-blue-900 shadow-md hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 animate-fade-in-up delay-300 relative overflow-hidden"
            >
              <!-- Hover Overlay Effect -->
              <div
                class="absolute inset-0 bg-blue-800 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"
              ></div>

              <svg
                class="w-10 h-10 text-white mb-3 group-hover:scale-125 transition-transform duration-300 relative z-10"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
              <span class="font-semibold text-white relative z-10 text-center"
                >API Docs</span
              >
              <span
                class="text-xs text-blue-200 mt-1 font-mono relative z-10 text-center"
                >/docs</span
              >
            </a>

            <!-- Button: Warehouse Web -->
            <a
              href="https://index.nusadaya.net"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col items-center justify-center p-6 rounded-xl border-2 border-slate-200 hover:border-blue-900 hover:bg-slate-50 transition-all duration-300 hover:-translate-y-2 hover:shadow-lg animate-fade-in-up delay-400"
            >
              <svg
                class="w-10 h-10 text-blue-900 mb-3 group-hover:scale-125 group-hover:-rotate-12 transition-transform duration-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                ></path>
              </svg>
              <span
                class="font-semibold text-slate-800 group-hover:text-blue-900 transition-colors text-center"
                >Warehouse</span
              >
              <span class="text-xs text-slate-400 mt-1 text-center"
                >index.nusadaya.net</span
              >
            </a>

            <!-- Button: Notification Realtime -->
            <a
              href="/realtime-notification"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col items-center justify-center p-6 rounded-xl border-2 border-slate-200 hover:border-blue-900 hover:bg-slate-50 transition-all duration-300 hover:-translate-y-2 hover:shadow-lg animate-fade-in-up delay-400"
            >
              <!-- Icon Lonceng / Bell -->
              <svg
                class="w-10 h-10 text-blue-900 mb-3 group-hover:scale-125 group-hover:animate-ring transition-transform duration-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
                ></path>
              </svg>
              <span
                class="font-semibold text-slate-800 group-hover:text-blue-900 transition-colors text-center"
                >Realtime Notification</span
              >
            </a>
          </div>
        </div>
      </div>

      <!-- Footer dengan variabel dinamis EJS -->
      <div
        class="text-center mt-8 text-sm text-slate-400 animate-fade-in-up delay-400"
      >
        &copy; <%= currentYear %> PT. PLN Nusa Daya. All rights reserved.
      </div>
    </div>
  </body>
</html>
