{
  "/task-status": {
    "get": {
      "tags": ["Task Status"],
      "summary": "List task statuses",
      "operationId": "getTaskStatuses",
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
        { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 } },
        { "name": "sort_by", "in": "query", "schema": { "type": "string", "enum": ["id", "status_name", "sort_order", "created_at", "updated_at"] } },
        { "name": "order_by", "in": "query", "schema": { "type": "string", "enum": ["ASC", "DESC"] } },
        { "name": "search", "in": "query", "schema": { "type": "string" } }
      ],
      "responses": {
        "200": { "description": "Paginated task statuses.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskStatusListResponse" } } } },
        "401": { "description": "Authentication required.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } }
      }
    },
    "post": {
      "tags": ["Task Status"],
      "summary": "Create a task status",
      "operationId": "createTaskStatus",
      "security": [{ "bearerAuth": [] }],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/TaskStatusInput" },
            "examples": { "create": { "summary": "Create task status", "value": { "status_name": "In Progress", "sort_order": 1 } } }
          }
        }
      },
      "responses": {
        "201": { "description": "Task status created.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskStatusResponse" } } } },
        "401": { "description": "Authentication required.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } },
        "409": { "description": "Status name or order already exists.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } },
        "422": { "description": "Request validation failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } }
      }
    }
  },
  "/task-status/{id}": {
    "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
    "get": {
      "tags": ["Task Status"],
      "summary": "Get a task status",
      "operationId": "getTaskStatusById",
      "security": [{ "bearerAuth": [] }],
      "responses": {
        "200": { "description": "Task status detail.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskStatusResponse" } } } },
        "401": { "description": "Authentication required.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } },
        "404": { "description": "Task status not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } }
      }
    },
    "put": {
      "tags": ["Task Status"],
      "summary": "Update a task status",
      "operationId": "updateTaskStatus",
      "security": [{ "bearerAuth": [] }],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/UpdateTaskStatusInput" },
            "examples": { "update": { "summary": "Update task status", "value": { "status_name": "In Progress", "sort_order": 2 } } }
          }
        }
      },
      "responses": {
        "200": { "description": "Task status updated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskStatusResponse" } } } },
        "401": { "description": "Authentication required.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } },
        "404": { "description": "Task status not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } },
        "409": { "description": "Status name already exists.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } },
        "422": { "description": "Request validation failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } }
      }
    },
    "delete": {
      "tags": ["Task Status"],
      "summary": "Delete a task status",
      "operationId": "deleteTaskStatus",
      "security": [{ "bearerAuth": [] }],
      "responses": {
        "200": { "description": "Task status deleted.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_SuccessResponse" } } } },
        "401": { "description": "Authentication required.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } },
        "409": { "description": "Task status is in use.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } },
        "404": { "description": "Task status not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } }
      }
    }
  }
}
