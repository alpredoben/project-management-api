{
  "/task-status/list": {
    "get": {
      "tags": ["Task Status"],
      "summary": "List task statuses",
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        { "name": "page", "in": "query", "default": 1, "schema": { "type": "integer", "minimum": 1 } },
        { "name": "limit", "in": "query", "default": 10, "schema": { "type": "integer", "minimum": 1, "maximum": 100 } },
        { "name": "search", "in": "query", "schema": { "type": "string" } },
        { "name": "sort_by", "in": "query", "schema": { "type": "string", "enum": ["name", "color_code", "sequence_order", "is_closed", "created_at", "updated_at"] } },
        { "name": "order_by", "in": "query", "schema": { "type": "string", "enum": ["ASC", "DESC"] } }
      ],
      "responses": {
        "200": {
          "description": "Paginated task statuses.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_PaginationResponse" }
            }
          }
        }
      }
    }
  },
  "/task-status/find/{id}": {
    "get": {
      "tags": ["Task Status"],
      "summary": "Find task status by ID",
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": {
        "200": {
          "description": "Task status found.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_SuccessResponse" }
            }
          }
        }
      }
    }
  },
  "/task-status/create": {
    "post": {
      "tags": ["Task Status"],
      "summary": "Create task status",
      "security": [{ "bearerAuth": [] }],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/CreateTaskStatusDto" }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Task status created.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_SuccessResponse" }
            }
          }
        },
        "409": { "description": "Task status name already exists." }
      }
    }
  },
  "/task-status/update/{id}": {
    "put": {
      "tags": ["Task Status"],
      "summary": "Update task status",
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/UpdateTaskStatusDto" }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Task status updated.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_SuccessResponse" }
            }
          }
        },
        "404": { "description": "Task status not found." },
        "409": { "description": "Task status name already exists." }
      }
    }
  },
  "/task-status/delete/{id}": {
    "delete": {
      "tags": ["Task Status"],
      "summary": "Delete task status",
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "responses": {
        "200": {
          "description": "Task status soft-deleted.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_SuccessResponse" }
            }
          }
        },
        "404": { "description": "Task status not found." }
      }
    }
  }
}