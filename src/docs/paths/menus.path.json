{
  "/menus": {
    "get": {
      "tags": ["Menus"],
      "summary": "List menus",
      "operationId": "getMenus",
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        {
          "name": "page",
          "in": "query",
          "schema": { "type": "integer", "minimum": 1, "default": 1 }
        },
        {
          "name": "limit",
          "in": "query",
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 10
          }
        },
        {
          "name": "sort_by",
          "in": "query",
          "schema": {
            "type": "string",
            "enum": [
              "id",
              "name",
              "slug",
              "path",
              "order_number",
              "created_at",
              "updated_at"
            ]
          }
        },
        {
          "name": "order_by",
          "in": "query",
          "schema": { "type": "string", "enum": ["ASC", "DESC"] }
        },
        { "name": "search", "in": "query", "schema": { "type": "string" } }
      ],
      "responses": {
        "200": {
          "description": "Paginated menus.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MenuListResponse" }
            }
          }
        },
        "401": {
          "description": "Authentication required.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_ErrorResponse" }
            }
          }
        }
      }
    },
    "post": {
      "tags": ["Menus"],
      "summary": "Create a menu",
      "operationId": "createMenu",
      "security": [{ "bearerAuth": [] }],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MenuInput" },
            "examples": {
              "create": {
                "summary": "Create root menu",
                "value": {
                  "name": "Projects",
                  "path": "/projects",
                  "icon": "folder",
                  "parent_id": null,
                  "order_number": 1
                }
              }
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Menu created.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MenuResponse" }
            }
          }
        },
        "400": {
          "description": "Invalid parent or menu order.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_ErrorResponse" }
            }
          }
        },
        "401": {
          "description": "Authentication required.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_ErrorResponse" }
            }
          }
        },
        "404": {
          "description": "Parent menu not found.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_ErrorResponse" }
            }
          }
        },
        "409": {
          "description": "Menu slug or sibling order already exists.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_ErrorResponse" }
            }
          }
        },
        "422": {
          "description": "Request validation failed.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_ErrorResponse" }
            }
          }
        }
      }
    }
  },
  "/menus/role-permissions": {
    "post": {
      "tags": ["Menus"],
      "summary": "Assign permissions to a menu for a role",
      "operationId": "assignRoleMenuPermissions",
      "security": [{ "bearerAuth": [] }],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RoleMenuPermissionInput"
            },
            "examples": {
              "assign": {
                "summary": "Assign menu permissions",
                "value": {
                  "role_id": "67a2e8de-4129-4db4-b6ef-02350c59ebaa",
                  "menu_id": "3cb1dd90-27ea-4b54-a6cb-f8711020aef8",
                  "permissions_ids": ["a5f728e0-0be4-4fa2-9fa5-6dca3b9159e2"]
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Menu permissions assigned.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleMenuPermissionsResponse"
              }
            }
          }
        },
        "400": {
          "description": "Permissions are not assigned to the role.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_ErrorResponse" }
            }
          }
        },
        "401": {
          "description": "Authentication required.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_ErrorResponse" }
            }
          }
        },
        "404": {
          "description": "Role, menu, or permission not found.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_ErrorResponse" }
            }
          }
        },
        "422": {
          "description": "Request validation failed.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_ErrorResponse" }
            }
          }
        }
      }
    }
  },
  "/menus/{id}": {
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }
    ],
    "get": {
      "tags": ["Menus"],
      "summary": "Get a menu",
      "operationId": "getMenuById",
      "security": [{ "bearerAuth": [] }],
      "responses": {
        "200": {
          "description": "Menu detail.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MenuResponse" }
            }
          }
        },
        "401": {
          "description": "Authentication required.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_ErrorResponse" }
            }
          }
        },
        "404": {
          "description": "Menu not found.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_ErrorResponse" }
            }
          }
        }
      }
    },
    "put": {
      "tags": ["Menus"],
      "summary": "Update a menu",
      "operationId": "updateMenu",
      "security": [{ "bearerAuth": [] }],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/UpdateMenuInput" },
            "examples": {
              "update": {
                "summary": "Update menu",
                "value": {
                  "name": "Project List",
                  "path": "/projects",
                  "icon": "folder",
                  "order_number": 2
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Menu updated.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MenuResponse" }
            }
          }
        },
        "400": {
          "description": "Update would create a parent cycle or invalid order.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_ErrorResponse" }
            }
          }
        },
        "401": {
          "description": "Authentication required.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_ErrorResponse" }
            }
          }
        },
        "404": {
          "description": "Menu or parent not found.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_ErrorResponse" }
            }
          }
        },
        "409": {
          "description": "Menu slug or sibling order already exists.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_ErrorResponse" }
            }
          }
        },
        "422": {
          "description": "Request validation failed.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_ErrorResponse" }
            }
          }
        }
      }
    },
    "delete": {
      "tags": ["Menus"],
      "summary": "Delete a menu",
      "operationId": "deleteMenu",
      "security": [{ "bearerAuth": [] }],
      "responses": {
        "200": {
          "description": "Menu deleted.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_SuccessResponse" }
            }
          }
        },
        "401": {
          "description": "Authentication required.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_ErrorResponse" }
            }
          }
        },
        "404": {
          "description": "Menu not found.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_ErrorResponse" }
            }
          }
        }
      }
    }
  }
}
