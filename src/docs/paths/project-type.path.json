{
  "/project-type": {
    "get": {
      "tags": ["Project Type"],
      "summary": "List project types",
      "operationId": "getProjectTypes",
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
        { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 } },
        { "name": "sort_by", "in": "query", "schema": { "type": "string", "enum": ["id", "type_name", "sort_order", "created_at", "updated_at"] } },
        { "name": "order_by", "in": "query", "schema": { "type": "string", "enum": ["ASC", "DESC"] } },
        { "name": "search", "in": "query", "schema": { "type": "string" } }
      ],
      "responses": {
        "200": { "description": "Paginated project types.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectTypeListResponse" } } } },
        "401": { "description": "Authentication required.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } }
      }
    },
    "post": {
      "tags": ["Project Type"],
      "summary": "Create a project type",
      "operationId": "createProjectType",
      "security": [{ "bearerAuth": [] }],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ProjectTypeInput" },
            "examples": { "create": { "summary": "Create project type", "value": { "type_name": "Infrastructure", "sort_order": 1 } } }
          }
        }
      },
      "responses": {
        "201": { "description": "Project type created.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectTypeResponse" } } } },
        "401": { "description": "Authentication required.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } },
        "409": { "description": "Type name or order already exists.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } },
        "422": { "description": "Request validation failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } }
      }
    }
  },
  "/project-type/dropdown": {
    "get": {
      "tags": ["Project Type"],
      "summary": "Get project type dropdown options",
      "operationId": "getProjectTypeDropdown",
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
        { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 } },
        { "name": "sort_by", "in": "query", "schema": { "type": "string", "enum": ["type_name"] } },
        { "name": "order_by", "in": "query", "schema": { "type": "string", "enum": ["ASC", "DESC"] } },
        { "name": "search", "in": "query", "schema": { "type": "string" } }
      ],
      "responses": {
        "200": { "description": "Project type options.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectTypeListResponse" } } } },
        "401": { "description": "Authentication required.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } }
      }
    }
  },
  "/project-type/{id}": {
    "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
    "get": {
      "tags": ["Project Type"],
      "summary": "Get a project type",
      "operationId": "getProjectTypeById",
      "security": [{ "bearerAuth": [] }],
      "responses": {
        "200": { "description": "Project type detail.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectTypeResponse" } } } },
        "401": { "description": "Authentication required.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } },
        "404": { "description": "Project type not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } }
      }
    },
    "put": {
      "tags": ["Project Type"],
      "summary": "Update a project type",
      "operationId": "updateProjectType",
      "security": [{ "bearerAuth": [] }],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/UpdateProjectTypeInput" },
            "examples": { "update": { "summary": "Update project type", "value": { "type_name": "Infrastructure", "sort_order": 2 } } }
          }
        }
      },
      "responses": {
        "200": { "description": "Project type updated.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectTypeResponse" } } } },
        "401": { "description": "Authentication required.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } },
        "404": { "description": "Project type not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } },
        "409": { "description": "Type name or order already exists.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } },
        "422": { "description": "Request validation failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } }
      }
    },
    "delete": {
      "tags": ["Project Type"],
      "summary": "Delete a project type",
      "operationId": "deleteProjectType",
      "security": [{ "bearerAuth": [] }],
      "responses": {
        "200": { "description": "Project type deleted.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_SuccessResponse" } } } },
        "401": { "description": "Authentication required.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } },
        "409": { "description": "Project type is in use.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } },
        "404": { "description": "Project type not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/In_ErrorResponse" } } } }
      }
    }
  }
}
