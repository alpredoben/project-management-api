{
  "/auth/register": {
    "post": {
      "tags": ["Authentication"],
      "summary": "Register account",
      "operationId": "register",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/RegisterDto" }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Account created and verification email sent.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_SuccessResponse" }
            }
          }
        }
      }
    }
  },
  "/auth/verified-email": {
    "get": {
      "tags": ["Authentication"],
      "summary": "Verify email address",
      "operationId": "verifyEmail",
      "parameters": [
        {
          "name": "token",
          "in": "query",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "responses": {
        "200": {
          "description": "Email verified.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_SuccessResponse" }
            }
          }
        }
      }
    }
  },
  "/auth/login": {
    "post": {
      "tags": ["Authentication"],
      "summary": "Login",
      "description": "Authenticate a user and issue an access token and a refresh token. The refresh token is stored server-side as a hash and is rotated when refreshed.",
      "operationId": "login",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/LoginDto"
            }
          }
        }
      },
      "responses": {
        "200": {
           "description": "Login successful.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginResponse" }
            }
          }
        }
      }
    }
  },
  "/auth/forgot-password": {
    "post": {
      "tags": ["Authentication"],
      "summary": "Request a password reset",
      "operationId": "forgotPassword",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ForgotPasswordDto" }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Reset instructions sent if the account exists.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_SuccessResponse" }
            }
          }
        }
      }
    }
  },
  "/auth/reset-password": {
    "post": {
      "tags": ["Authentication"],
      "summary": "Reset password",
      "description": "Pass the one-time token as a query parameter or in the JSON body.",
      "operationId": "resetPassword",
      "parameters": [
        {
          "name": "token",
          "in": "query",
          "required": false,
          "schema": { "type": "string" }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ResetPasswordDto" }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Password changed.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_SuccessResponse" }
            }
          }
        }
      }
    }
  },
  "/auth/refersh-token": {
    "post": {
      "tags": ["Authentication"],
      "summary": "Refresh tokens",
      "description": "Supply the refresh JWT in the access_token field. The token is rotated and can only be used once.",
      "operationId": "refreshAuthTokensTypoCompatibility",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/RefreshTokenDto" }
          }
        }
      },
      "responses": {
        "200": {
         "description": "New access and refresh tokens issued.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/In_SuccessResponse" }
            }
          }
        }
      }
    }
  },
  "/auth/refresh-token": {
    "post": {
      "tags": ["Authentication"],
      "summary": "Refresh tokens",
      "description": "Supply the refresh JWT in the access_token field (or refresh_token for compatibility). The token is rotated and can only be used once.",
      "operationId": "refreshAuthTokens",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RefreshTokenDto"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "New access and refresh tokens issued.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenResponse"
              }
            }
          }
        }
      }
    }
  },
  "/auth/logout": {
    "post": {
      "tags": ["Authentication"],
      "summary": "Logout",
      "description": "Revoke the current refresh token and mark the user as logged out. The current access token remains valid until it expires.",
      "operationId": "logout",
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Logout successful.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/In_SuccessResponse"
              }
            }
          }
        }
      }
    }
  },
  "/auth/me": {
    "get": {
      "tags": ["Authentication"],
      "summary": "Get current user profile",
      "description": "Return the profile and active roles for the user identified by the access token.",
      "operationId": "getCurrentUser",
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Current user profile retrieved.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/In_SuccessResponse"
              }
            }
          }
        }
      }
    }
  }
}
