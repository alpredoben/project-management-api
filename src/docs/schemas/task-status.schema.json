{
  "TaskStatusInput": {
    "type": "object",
    "required": ["status_name", "sort_order"],
    "properties": {
      "status_name": { "type": "string", "maxLength": 100, "example": "In Progress" },
      "sort_order": { "type": "integer", "minimum": 0, "example": 1 }
    },
    "example": { "status_name": "In Progress", "sort_order": 1 }
  },
  "UpdateTaskStatusInput": {
    "type": "object",
    "minProperties": 1,
    "properties": {
      "status_name": { "type": "string", "maxLength": 100, "example": "In Progress" },
      "sort_order": { "type": "integer", "minimum": 0, "example": 2 }
    },
    "example": { "status_name": "In Progress", "sort_order": 2 }
  },
  "TaskStatus": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "format": "uuid" },
      "status_name": { "type": "string" },
      "sort_order": { "type": "integer" },
      "created_at": { "type": "string", "format": "date-time" },
      "created_by": { "type": "string", "nullable": true },
      "updated_at": { "type": "string", "format": "date-time" },
      "updated_by": { "type": "string", "nullable": true }
    }
  },
  "TaskStatusResponse": {
    "allOf": [
      { "$ref": "#/components/schemas/In_SuccessResponse" },
      {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/TaskStatus" }
        }
      }
    ]
  },
  "TaskStatusListResponse": {
    "allOf": [
      { "$ref": "#/components/schemas/In_PaginationResponse" },
      {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TaskStatus" }
          }
        }
      }
    ]
  }
}
