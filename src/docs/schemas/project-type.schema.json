{
  "ProjectTypeInput": {
    "type": "object",
    "required": ["type_name", "sort_order"],
    "properties": {
      "type_name": { "type": "string", "maxLength": 100, "example": "Infrastructure" },
      "sort_order": { "type": "integer", "minimum": 0, "example": 1 }
    },
    "example": { "type_name": "Infrastructure", "sort_order": 1 }
  },
  "UpdateProjectTypeInput": {
    "type": "object",
    "minProperties": 1,
    "properties": {
      "type_name": { "type": "string", "maxLength": 100, "example": "Infrastructure" },
      "sort_order": { "type": "integer", "minimum": 0, "example": 2 }
    },
    "example": { "type_name": "Infrastructure", "sort_order": 2 }
  },
  "ProjectType": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "format": "uuid" },
      "type_name": { "type": "string" },
      "sort_order": { "type": "integer" },
      "created_at": { "type": "string", "format": "date-time" },
      "created_by": { "type": "string", "nullable": true },
      "updated_at": { "type": "string", "format": "date-time" },
      "updated_by": { "type": "string", "nullable": true }
    }
  },
  "ProjectTypeResponse": {
    "allOf": [
      { "$ref": "#/components/schemas/In_SuccessResponse" },
      {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/ProjectType" }
        }
      }
    ]
  },
  "ProjectTypeListResponse": {
    "allOf": [
      { "$ref": "#/components/schemas/In_PaginationResponse" },
      {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProjectType" }
          }
        }
      }
    ]
  }
}
