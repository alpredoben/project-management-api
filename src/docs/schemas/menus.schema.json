{
  "MenuInput": {
    "type": "object",
    "required": ["name", "path"],
    "properties": {
      "name": { "type": "string", "maxLength": 100, "example": "Projects" },
      "path": { "type": "string", "maxLength": 255, "example": "/projects" },
      "icon": { "type": "string", "nullable": true, "maxLength": 50, "example": "folder" },
      "parent_id": { "type": "string", "format": "uuid", "nullable": true, "example": null },
      "order_number": { "type": "integer", "minimum": 0, "default": 0, "example": 1 }
    },
    "example": {
      "name": "Projects",
      "path": "/projects",
      "icon": "folder",
      "parent_id": null,
      "order_number": 1
    }
  },
  "UpdateMenuInput": {
    "type": "object",
    "minProperties": 1,
    "properties": {
      "name": { "type": "string", "maxLength": 100, "example": "Project List" },
      "path": { "type": "string", "maxLength": 255, "example": "/projects" },
      "icon": { "type": "string", "nullable": true, "maxLength": 50, "example": "folder" },
      "parent_id": { "type": "string", "format": "uuid", "nullable": true },
      "order_number": { "type": "integer", "minimum": 0, "example": 2 }
    },
    "example": {
      "name": "Project List",
      "path": "/projects",
      "icon": "folder",
      "order_number": 2
    }
  },
  "RoleMenuPermissionInput": {
    "type": "object",
    "required": ["role_id", "menu_id", "permissions_ids"],
    "properties": {
      "role_id": { "type": "string", "format": "uuid" },
      "menu_id": { "type": "string", "format": "uuid" },
      "permissions_ids": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "format": "uuid" }
      }
    },
    "example": {
      "role_id": "67a2e8de-4129-4db4-b6ef-02350c59ebaa",
      "menu_id": "3cb1dd90-27ea-4b54-a6cb-f8711020aef8",
      "permissions_ids": ["a5f728e0-0be4-4fa2-9fa5-6dca3b9159e2"]
    }
  },
  "Menu": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "format": "uuid" },
      "name": { "type": "string" },
      "slug": { "type": "string" },
      "path": { "type": "string" },
      "icon": { "type": "string", "nullable": true },
      "parent_id": { "type": "string", "format": "uuid", "nullable": true },
      "order_number": { "type": "integer" },
      "created_at": { "type": "string", "format": "date-time" },
      "created_by": { "type": "string", "nullable": true },
      "updated_at": { "type": "string", "format": "date-time" },
      "updated_by": { "type": "string", "nullable": true },
      "deleted_at": { "type": "string", "format": "date-time", "nullable": true },
      "deleted_by": { "type": "string", "nullable": true }
    }
  },
  "MenuResponse": {
    "allOf": [
      { "$ref": "#/components/schemas/In_SuccessResponse" },
      {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/Menu" }
        }
      }
    ]
  },
  "RoleMenuPermissionAssignment": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "format": "uuid" },
      "role_id": { "type": "string", "format": "uuid" },
      "menu_id": { "type": "string", "format": "uuid" },
      "permission_id": { "type": "string", "format": "uuid" },
      "created_at": { "type": "string", "format": "date-time" },
      "created_by": { "type": "string", "nullable": true },
      "updated_at": { "type": "string", "format": "date-time" },
      "updated_by": { "type": "string", "nullable": true }
    }
  },
  "RoleMenuPermissionsResponse": {
    "allOf": [
      { "$ref": "#/components/schemas/In_SuccessResponse" },
      {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RoleMenuPermissionAssignment" }
          }
        }
      }
    ]
  },
  "MenuListResponse": {
    "allOf": [
      { "$ref": "#/components/schemas/In_PaginationResponse" },
      {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Menu" }
          }
        }
      }
    ]
  }
}
