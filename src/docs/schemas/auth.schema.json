{
  "LoginDto": {
    "type": "object",
    "required": ["email", "password"],
    "properties": {
      "email": {
        "type": "string",
        "format": "email",
        "example": "admin@example.com",
        "default": "admin@example.com"
      },
      "password": {
        "type": "string",
        "format": "password",
        "writeOnly": true,
        "example": "c0mplexP@ssw0rd",
        "default": "c0mplexP@ssw0rd"
      },
      "remember_me": { "type": "boolean", "default": false, "example": false }
    },
    "example": {
      "email": "admin@example.com",
      "password": "c0mplexP@ssw0rd",
      "remember_me": false
    }
  },
  "RefreshTokenDto": {
    "type": "object",
    "required": ["refreshToken"],
    "properties": {
      "refreshToken": {
        "type": "string",
        "minLength": 1,
        "example": "eyJ...refresh-token"
      }
    },
    "example": { "refreshToken": "eyJ...refresh-token" }
  },
  "AuthPermission": {
    "type": "object",
    "required": ["id", "name", "slug"],
    "properties": {
      "id": { "type": "string", "format": "uuid" },
      "name": { "type": "string", "example": "View Projects" },
      "slug": { "type": "string", "example": "view-projects" }
    }
  },
  "AuthRole": {
    "type": "object",
    "required": ["id", "name", "slug", "permissions"],
    "properties": {
      "id": { "type": "string", "format": "uuid" },
      "name": { "type": "string", "example": "Project Manager" },
      "slug": {
        "type": "string",
        "nullable": true,
        "example": "project-manager"
      },
      "permissions": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/AuthPermission" }
      }
    }
  },
  "AuthMenuParent": {
    "type": "object",
    "required": [
      "id",
      "name",
      "slug",
      "icon",
      "order_number",
      "parent",
      "children"
    ],
    "properties": {
      "id": { "type": "string", "format": "uuid" },
      "name": { "type": "string" },
      "slug": { "type": "string" },
      "path": { "type": "string" },
      "icon": { "type": "string", "nullable": true },
      "parent_id": { "type": "string", "format": "uuid", "nullable": true },
      "order_number": { "type": "integer" },
      "parent": {
        "nullable": true,
        "allOf": [{ "$ref": "#/components/schemas/AuthMenuParent" }]
      },
      "children": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/AuthMenuParent" }
      }
    }
  },
  "AuthMenu": {
    "allOf": [
      { "$ref": "#/components/schemas/AuthMenuParent" },
      {
        "type": "object",
        "properties": {
          "children": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AuthMenu" }
          }
        }
      }
    ]
  },
  "AuthRoleMenuPermission": {
    "type": "object",
    "required": ["role", "menu"],
    "properties": {
      "role": {
        "type": "object",
        "required": ["id", "name", "slug"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "slug": { "type": "string", "nullable": true }
        }
      },
      "menu": { "$ref": "#/components/schemas/AuthMenu" }
    }
  },
  "AuthUserProfile": {
    "type": "object",
    "required": [
      "id",
      "name",
      "email",
      "phone",
      "avatar",
      "is_active",
      "is_login",
      "last_login_at",
      "roles",
      "permissions",
      "role_menu_permission"
    ],
    "properties": {
      "id": { "type": "string", "format": "uuid" },
      "name": { "type": "string", "nullable": true, "example": "Example User" },
      "email": {
        "type": "string",
        "format": "email",
        "example": "user@example.com"
      },
      "phone": {
        "type": "string",
        "nullable": true,
        "example": "+6281234567890"
      },
      "avatar": { "type": "string", "nullable": true },
      "is_active": { "type": "boolean", "example": true },
      "is_login": { "type": "boolean", "example": true },
      "last_login_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "roles": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/AuthRole" }
      },
      "permissions": {
        "type": "array",
        "description": "Unique active permissions from assigned roles.",
        "items": { "$ref": "#/components/schemas/AuthPermission" }
      },
      "role_menu_permission": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/AuthRoleMenuPermission" }
      }
    }
  },
  "AuthTokenPair": {
    "type": "object",
    "required": ["token_type", "access_token", "refresh_token"],
    "properties": {
      "token_type": {
        "type": "string",
        "enum": ["Bearer"],
        "example": "Bearer"
      },
      "access_token": {
        "type": "string",
        "description": "JWT access token.",
        "example": "eyJ...access-token"
      },
      "refresh_token": {
        "type": "string",
        "description": "JWT refresh token.",
        "example": "eyJ...refresh-token"
      }
    }
  },
  "LoginResponse": {
    "allOf": [
      { "$ref": "#/components/schemas/In_SuccessResponse" },
      {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/AuthTokenPair" }
        }
      }
    ]
  },
  "RefreshTokenResponse": {
    "allOf": [
      { "$ref": "#/components/schemas/In_SuccessResponse" },
      {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/AuthTokenPair" }
        }
      }
    ]
  },
  "LogoutResponse": {
    "allOf": [
      { "$ref": "#/components/schemas/In_SuccessResponse" },
      {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Logout berhasil." }
        }
      }
    ]
  },
  "CurrentUserResponse": {
    "allOf": [
      { "$ref": "#/components/schemas/In_SuccessResponse" },
      {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/AuthUserProfile" }
        }
      }
    ]
  }
}
