{
  "LoginDto": {
    "type": "object",
    "required": ["email", "password"],
    "properties": {
      "email": { "type": "string", "example": "user@example.com" },
      "password": { "type": "string", "example": "password123" },
      "remember_me": { "type": "boolean", "example": true }
    }
  },
  "RefreshTokenDto": {
    "type": "object",
    "required": ["refreshToken"],
    "properties": {
      "refreshToken": {
        "type": "string",
        "example": "eyJhbGciOiJIUzI1NiIsInR..."
      }
    }
  }
}
