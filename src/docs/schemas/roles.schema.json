{
  "CreateRoleDto": {
    "type": "object",
    "required": ["name"],
    "properties": {
      "name": { "type": "string", "maxLength": 100, "example": "Project Manager" },
      "slug": { "type": "string", "nullable": true, "maxLength": 100, "example": "project-manager" },
      "description": { "type": "string", "nullable": true, "example": "Manages project work." }
    }
  },
  "UpdateRoleDto": {
    "type": "object",
    "minProperties": 1,
    "properties": {
      "name": { "type": "string", "maxLength": 100 },
      "slug": { "type": "string", "nullable": true, "maxLength": 100 },
      "description": { "type": "string", "nullable": true }
    }
  },
  "Role": {
    "type": "object",
    "required": ["id", "name", "slug", "description", "created_at", "updated_at"],
    "properties": {
      "id": { "type": "string", "format": "uuid" },
      "name": { "type": "string" },
      "slug": { "type": "string", "nullable": true },
      "description": { "type": "string", "nullable": true },
      "created_at": { "type": "string", "format": "date-time" },
      "created_by": { "type": "string", "nullable": true },
      "updated_at": { "type": "string", "format": "date-time" },
      "updated_by": { "type": "string", "nullable": true },
      "deleted_at": { "type": "string", "format": "date-time", "nullable": true },
      "deleted_by": { "type": "string", "nullable": true }
    }
  },
  "RoleResponse": {
    "allOf": [
      { "$ref": "#/components/schemas/In_SuccessResponse" },
      {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/Role" }
        }
      }
    ]
  },
  "RoleListResponse": {
    "allOf": [
      { "$ref": "#/components/schemas/In_PaginationResponse" },
      {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Role" }
          }
        }
      }
    ]
  }
}
