{
  "Workspace": {
    "type": "object",
    "required": ["id", "name", "slug", "logo_url"],
    "properties": {
      "id": { "type": "string", "format": "uuid" },
      "name": { "type": "string", "maxLength": 150 },
      "slug": { "type": "string", "maxLength": 150 },
      "logo_url": { "type": "string", "nullable": true },
      "created_at": { "type": "string", "format": "date-time" },
      "updated_at": { "type": "string", "format": "date-time" }
    }
  },
  "CreateWorkspaceDto": {
    "type": "object",
    "required": ["name"],
    "properties": {
      "name": { "type": "string", "maxLength": 150 },
      "logo_url": { "type": "string", "nullable": true }
    }
  },
  "UpdateWorkspaceDto": {
    "type": "object",
    "minProperties": 1,
    "properties": {
      "name": { "type": "string", "maxLength": 150 },
      "logo_url": { "type": "string", "nullable": true }
    }
  },
  "WorkspaceMember": {
    "type": "object",
    "required": ["id", "workspace_id", "user_id", "position_id", "joined_at"],
    "properties": {
      "id": { "type": "string", "format": "uuid" },
      "workspace_id": { "type": "string", "format": "uuid" },
      "user_id": { "type": "string", "format": "uuid" },
      "position_id": { "type": "string", "format": "uuid", "nullable": true },
      "joined_at": { "type": "string", "format": "date-time" },
      "workspace": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "logo_url": { "type": "string", "nullable": true }
        }
      },
      "user": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "avatarUrl": { "type": "string", "nullable": true }
        }
      },
      "position": {
        "type": "object",
        "nullable": true,
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "slug": { "type": "string" }
        }
      }
    }
  },
  "AddUpdateWorkspaceMembersDto": {
    "type": "object",
    "required": ["user_ids"],
    "properties": {
      "user_ids": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "format": "uuid" }
      }
    }
  }
}