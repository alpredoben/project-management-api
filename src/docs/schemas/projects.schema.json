{
  "ProjectInput": {
    "type": "object",
    "required": ["project_code", "project_name"],
    "properties": {
      "project_type_id": { "type": "string", "format": "uuid", "nullable": true },
      "project_status_id": { "type": "string", "format": "uuid", "nullable": true },
      "project_code": { "type": "string", "maxLength": 50, "example": "PRJ-2026-001" },
      "project_name": { "type": "string", "maxLength": 200, "example": "Grid Modernization" },
      "description": { "type": "string", "nullable": true, "example": "Modernize regional grid infrastructure." },
      "owner_id": { "type": "string", "format": "uuid", "nullable": true },
      "parent_id": { "type": "string", "format": "uuid", "nullable": true },
      "max_contributors": { "type": "integer", "minimum": 0, "default": 0 },
      "start_date": { "type": "string", "format": "date", "nullable": true, "example": "2026-11-02" },
      "end_date": { "type": "string", "format": "date", "nullable": true, "example": "2027-06-30" }
    },
    "example": {
      "project_type_id": "a5f728e0-0be4-4fa2-9fa5-6dca3b9159e2",
      "project_status_id": "3cb1dd90-27ea-4b54-a6cb-f8711020aef8",
      "project_code": "PRJ-2026-001",
      "project_name": "Grid Modernization",
      "description": "Modernize regional grid infrastructure.",
      "owner_id": "67a2e8de-4129-4db4-b6ef-02350c59ebaa",
      "parent_id": null,
      "max_contributors": 8,
      "start_date": "2026-11-02",
      "end_date": "2027-06-30"
    }
  },
  "UpdateProjectInput": {
    "type": "object",
    "minProperties": 1,
    "properties": {
      "project_type_id": { "type": "string", "format": "uuid", "nullable": true },
      "project_status_id": { "type": "string", "format": "uuid", "nullable": true },
      "project_code": { "type": "string", "maxLength": 50 },
      "project_name": { "type": "string", "maxLength": 200 },
      "description": { "type": "string", "nullable": true },
      "owner_id": { "type": "string", "format": "uuid", "nullable": true },
      "parent_id": { "type": "string", "format": "uuid", "nullable": true },
      "max_contributors": { "type": "integer", "minimum": 0 },
      "start_date": { "type": "string", "format": "date", "nullable": true },
      "end_date": { "type": "string", "format": "date", "nullable": true }
    },
    "example": {
      "project_name": "Grid Modernization Phase 1",
      "project_status_id": "3cb1dd90-27ea-4b54-a6cb-f8711020aef8",
      "end_date": "2027-08-31"
    }
  },
  "Project": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "format": "uuid" },
      "project_type_id": { "type": "string", "format": "uuid", "nullable": true },
      "project_status_id": { "type": "string", "format": "uuid", "nullable": true },
      "project_code": { "type": "string" },
      "project_name": { "type": "string" },
      "description": { "type": "string", "nullable": true },
      "owner_id": { "type": "string", "format": "uuid", "nullable": true },
      "parent_id": { "type": "string", "format": "uuid", "nullable": true },
      "max_contributors": { "type": "integer" },
      "start_date": { "type": "string", "format": "date", "nullable": true },
      "end_date": { "type": "string", "format": "date", "nullable": true },
      "created_at": { "type": "string", "format": "date-time" },
      "created_by": { "type": "string", "nullable": true },
      "updated_at": { "type": "string", "format": "date-time" },
      "updated_by": { "type": "string", "nullable": true }
    }
  },
  "ProjectResponse": {
    "allOf": [
      { "$ref": "#/components/schemas/In_SuccessResponse" },
      {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/Project" }
        }
      }
    ]
  },
  "ProjectListResponse": {
    "allOf": [
      { "$ref": "#/components/schemas/In_PaginationResponse" },
      {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Project" }
          }
        }
      }
    ]
  }
}
