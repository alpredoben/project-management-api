{
  "PermissionInput": {
    "type": "object",
    "required": ["name"],
    "properties": {
      "name": {
        "type": "string",
        "maxLength": 100,
        "example": "View Projects"
      }
    },
    "example": {
      "name": "View Projects"
    }
  },
  "UpdatePermissionInput": {
    "type": "object",
    "minProperties": 1,
    "properties": {
      "name": {
        "type": "string",
        "maxLength": 100,
        "example": "View Projects"
      }
    },
    "example": {
      "name": "View Projects"
    }
  },
  "Permission": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "format": "uuid" },
      "name": { "type": "string", "example": "View Projects" },
      "slug": { "type": "string", "example": "view-projects" },
      "created_at": { "type": "string", "format": "date-time" },
      "created_by": { "type": "string", "nullable": true },
      "updated_at": { "type": "string", "format": "date-time" },
      "updated_by": { "type": "string", "nullable": true },
      "deleted_at": { "type": "string", "format": "date-time", "nullable": true },
      "deleted_by": { "type": "string", "nullable": true }
    }
  },
  "PermissionResponse": {
    "allOf": [
      { "$ref": "#/components/schemas/In_SuccessResponse" },
      {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/Permission" }
        }
      }
    ]
  },
  "PermissionListResponse": {
    "allOf": [
      { "$ref": "#/components/schemas/In_PaginationResponse" },
      {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Permission" }
          }
        }
      }
    ]
  }
}
